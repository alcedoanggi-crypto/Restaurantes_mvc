# Copia este archivo como .env y ajusta los valores
SECRET_KEY=cambia-esta-clave-en-produccion
FLASK_DEBUG=1

# --- Base de datos ---
# SQLite (por defecto si dejas DATABASE_URL comentado, no requiere instalar nada):
#   (sin DATABASE_URL)
#
# PostgreSQL (config.py fuerza el driver psycopg v3 automáticamente;
#             instala con:  pip install "psycopg[binary]"):
DATABASE_URL=postgresql://restaurante:123456@localhost:5432/restaurante

# Impuesto aplicado en facturación (0.16 = 16%)
IVA=0.16

# Umbrales del semáforo del KDS (minutos)
KDS_WARN_MIN=8
KDS_LATE_MIN=15
